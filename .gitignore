# StrikeFactor player data lives in the per-user data directory
# (strikefactor/paths.py), never in the repository. These catch copies left in
# the old in-package locations, so they can't be committed again.
strikefactor/data/strikefactor.db*
strikefactor/data/backups/
strikefactor/data/archives/
strikefactor/data/gameday_archives/
strikefactor/data/batting_stats*.json
strikefactor/data/lap_history.json
strikefactor/data/gameday_history.json
strikefactor/data/gameday_sessions.json
strikefactor/data/.legacy-layout-migrated.json

# Generated analysis output
analysis_output/

# User-local config
settings.json
key_bindings.json

# Stale AI model backups (e.g. sasaki_ai.pkl.pre-fo-merge)
*.pkl.pre-*

